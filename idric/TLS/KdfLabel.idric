module TLS.KdfLabel

%default total

public export
choice tls13_kdf_purpose one_of
  external_binder
  resumption_binder
  client_early_traffic
  early_exporter_master
  derived_secret
  client_handshake_traffic
  server_handshake_traffic
  client_application_traffic
  server_application_traffic
  exporter_master
  resumption_master
  finished_key
  traffic_key
  traffic_iv
  traffic_update

public export
kdf_purpose_bytes : tls13_kdf_purpose → List Bits8
kdf_purpose_bytes external_binder =
  [101, 120, 116, 32, 98, 105, 110, 100, 101, 114]
kdf_purpose_bytes resumption_binder =
  [114, 101, 115, 32, 98, 105, 110, 100, 101, 114]
kdf_purpose_bytes client_early_traffic =
  [99, 32, 101, 32, 116, 114, 97, 102, 102, 105, 99]
kdf_purpose_bytes early_exporter_master =
  [101, 32, 101, 120, 112, 32, 109, 97, 115, 116, 101, 114]
kdf_purpose_bytes derived_secret =
  [100, 101, 114, 105, 118, 101, 100]
kdf_purpose_bytes client_handshake_traffic =
  [99, 32, 104, 115, 32, 116, 114, 97, 102, 102, 105, 99]
kdf_purpose_bytes server_handshake_traffic =
  [115, 32, 104, 115, 32, 116, 114, 97, 102, 102, 105, 99]
kdf_purpose_bytes client_application_traffic =
  [99, 32, 97, 112, 32, 116, 114, 97, 102, 102, 105, 99]
kdf_purpose_bytes server_application_traffic =
  [115, 32, 97, 112, 32, 116, 114, 97, 102, 102, 105, 99]
kdf_purpose_bytes exporter_master =
  [101, 120, 112, 32, 109, 97, 115, 116, 101, 114]
kdf_purpose_bytes resumption_master =
  [114, 101, 115, 32, 109, 97, 115, 116, 101, 114]
kdf_purpose_bytes finished_key =
  [102, 105, 110, 105, 115, 104, 101, 100]
kdf_purpose_bytes traffic_key = [107, 101, 121]
kdf_purpose_bytes traffic_iv = [105, 118]
kdf_purpose_bytes traffic_update =
  [116, 114, 97, 102, 102, 105, 99, 32, 117, 112, 100]

tls13_label_prefix : List Bits8
tls13_label_prefix = [116, 108, 115, 49, 51, 32]

public export
record hkdf_label where
  constructor MkHkdfLabel
  hkdf_output_length : ℕ
  hkdf_purpose : tls13_kdf_purpose
  hkdf_context : List Bits8

public export
make_hkdf_label :
  ℕ →
  tls13_kdf_purpose →
  List Bits8 →
  Either String hkdf_label
make_hkdf_label output_length purpose context =
  if output_length > 65535
    then Left "TLS HKDF output length exceeds uint16"
    else if length context > 255
      then Left "TLS HKDF context exceeds 255 bytes"
      else Right (MkHkdfLabel output_length purpose context)

u16_bytes : ℕ → List Bits8
u16_bytes number =
  [ cast (div number 256)
  , cast (mod number 256)
  ]

public export
encode_hkdf_label : hkdf_label → List Bits8
encode_hkdf_label (MkHkdfLabel output_length purpose context) =
  let complete_label = tls13_label_prefix ++ kdf_purpose_bytes purpose in
    u16_bytes output_length ++
    [cast (length complete_label)] ++
    complete_label ++
    [cast (length context)] ++
    context
