module TLS.Hello

import TLS.Extension

%default total

public export
record cipher_suite_code where
  constructor MkCipherSuiteCode
  cipher_suite_code_bits : Bits16

public export
choice tls13_cipher_suite one_of
  tls_aes_128_gcm_sha256
  tls_aes_256_gcm_sha384
  tls_chacha20_poly1305_sha256
  tls_aes_128_ccm_sha256
  tls_aes_128_ccm_8_sha256

public export
tls13_cipher_suite_from_code : cipher_suite_code → Maybe tls13_cipher_suite
tls13_cipher_suite_from_code (MkCipherSuiteCode 4865) = Just tls_aes_128_gcm_sha256
tls13_cipher_suite_from_code (MkCipherSuiteCode 4866) = Just tls_aes_256_gcm_sha384
tls13_cipher_suite_from_code (MkCipherSuiteCode 4867) = Just tls_chacha20_poly1305_sha256
tls13_cipher_suite_from_code (MkCipherSuiteCode 4868) = Just tls_aes_128_ccm_sha256
tls13_cipher_suite_from_code (MkCipherSuiteCode 4869) = Just tls_aes_128_ccm_8_sha256
tls13_cipher_suite_from_code _ = Nothing

wire_u16 : Bits8 → Bits8 → Bits16
wire_u16 high low = cast high * 256 + cast low

take_bytes_exact : ℕ → List Bits8 → Maybe (List Bits8, List Bits8)
take_bytes_exact 0 bytes = Just ([], bytes)
take_bytes_exact (S remaining) [] = Nothing
take_bytes_exact (S remaining) (byte :: rest) =
  case take_bytes_exact remaining rest of
    Nothing => Nothing
    Just (taken, trailing) => Just (byte :: taken, trailing)

parse_cipher_suite_codes : List Bits8 → Either String (List cipher_suite_code)
parse_cipher_suite_codes [] = Right []
parse_cipher_suite_codes (high :: low :: rest) =
  case parse_cipher_suite_codes rest of
    Left problem => Left problem
    Right suites => Right (MkCipherSuiteCode (wire_u16 high low) :: suites)
parse_cipher_suite_codes _ = Left "cipher suite vector has an odd byte length"

client_supported_versions : List tls_extension → Either String (List protocol_version)
client_supported_versions extensions =
  case find_single_extension supported_versions_code extensions of
    Left problem => Left problem
    Right Nothing => Left "TLS 1.3 ClientHello is missing supported_versions"
    Right (Just extension) => parse_client_supported_versions extension

validate_client_tls13_version : List tls_extension → Either String ()
validate_client_tls13_version extensions =
  case client_supported_versions extensions of
    Left problem => Left problem
    Right versions =>
      if versions_include_tls13 versions
        then Right ()
        else Left "ClientHello does not offer TLS 1.3"

public export
record tls13_client_hello where
  constructor MkTls13ClientHello
  client_random : List Bits8
  client_legacy_session_id : List Bits8
  client_cipher_suites : List cipher_suite_code
  client_extensions : List tls_extension

parse_client_extensions :
  List Bits8 →
  List Bits8 →
  List cipher_suite_code →
  Either String tls13_client_hello
parse_client_extensions random session_id suites bytes =
  case parse_extension_vector bytes of
    Left problem => Left problem
    Right (MkParsedExtensionVector extensions []) =>
      case validate_client_tls13_version extensions of
        Left problem => Left problem
        Right () => Right (MkTls13ClientHello random session_id suites extensions)
    Right (MkParsedExtensionVector _ _) => Left "bytes remain after ClientHello extensions"

parse_client_compression :
  List Bits8 →
  List Bits8 →
  List cipher_suite_code →
  Either String tls13_client_hello
parse_client_compression random session_id suites [] =
  Left "ClientHello is missing legacy compression methods"
parse_client_compression random session_id suites (compression_length :: rest) =
  let compression_length_number : ℕ = cast compression_length in
    case take_bytes_exact compression_length_number rest of
      Nothing => Left "ClientHello legacy compression vector is truncated"
      Just ([0], after_compression) =>
        parse_client_extensions random session_id suites after_compression
      Just (_, _) =>
        Left "TLS 1.3 ClientHello legacy compression methods must be exactly [0]"

parse_client_cipher_suites :
  List Bits8 →
  List Bits8 →
  List Bits8 →
  Either String tls13_client_hello
parse_client_cipher_suites random session_id (length_high :: length_low :: rest) =
  let suite_bytes_length : ℕ = cast (wire_u16 length_high length_low) in
    if suite_bytes_length < 2
      then Left "ClientHello must offer at least one cipher suite"
      else case take_bytes_exact suite_bytes_length rest of
        Nothing => Left "ClientHello cipher suite vector is truncated"
        Just (suite_bytes, after_suites) =>
          case parse_cipher_suite_codes suite_bytes of
            Left problem => Left problem
            Right suites =>
              parse_client_compression random session_id suites after_suites
parse_client_cipher_suites _ _ _ = Left "ClientHello is missing cipher suite length"

parse_client_session : List Bits8 → List Bits8 → Either String tls13_client_hello
parse_client_session random [] = Left "ClientHello is missing legacy session id length"
parse_client_session random (session_length :: rest) =
  let session_length_number : ℕ = cast session_length in
    if session_length_number > 32
      then Left "ClientHello legacy session id exceeds 32 bytes"
      else case take_bytes_exact session_length_number rest of
        Nothing => Left "ClientHello legacy session id is truncated"
        Just (session_id, after_session) =>
          parse_client_cipher_suites random session_id after_session

public export
parse_tls13_client_hello : List Bits8 → Either String tls13_client_hello
parse_tls13_client_hello (3 :: 3 :: rest) =
  case take_bytes_exact 32 rest of
    Nothing => Left "ClientHello random is truncated"
    Just (random, after_random) => parse_client_session random after_random
parse_tls13_client_hello (_ :: _ :: _) =
  Left "TLS 1.3 ClientHello legacy_version must be 0x0303"
parse_tls13_client_hello _ = Left "ClientHello is missing legacy_version"

public export
choice tls13_server_hello_kind one_of
  negotiated_server_hello
  hello_retry_request

hello_retry_request_random : List Bits8
hello_retry_request_random =
  [207, 33, 173, 116, 229, 154, 97, 17,
   190, 29, 140, 2, 30, 101, 184, 145,
   194, 162, 17, 22, 122, 187, 140, 94,
   7, 158, 9, 226, 200, 168, 51, 156]

server_hello_kind : List Bits8 → tls13_server_hello_kind
server_hello_kind random =
  if random == hello_retry_request_random
    then hello_retry_request
    else negotiated_server_hello

server_supported_version : List tls_extension → Either String protocol_version
server_supported_version extensions =
  case find_single_extension supported_versions_code extensions of
    Left problem => Left problem
    Right Nothing => Left "TLS 1.3 ServerHello is missing supported_versions"
    Right (Just extension) => parse_server_supported_version extension

public export
record tls13_server_hello where
  constructor MkTls13ServerHello
  server_kind : tls13_server_hello_kind
  server_random : List Bits8
  server_legacy_session_id_echo : List Bits8
  server_cipher_suite_code : cipher_suite_code
  server_cipher_suite : tls13_cipher_suite
  server_extensions : List tls_extension

parse_server_extensions :
  List Bits8 →
  List Bits8 →
  cipher_suite_code →
  tls13_cipher_suite →
  List Bits8 →
  Either String tls13_server_hello
parse_server_extensions random session_id suite_code suite bytes =
  case parse_extension_vector bytes of
    Left problem => Left problem
    Right (MkParsedExtensionVector extensions []) =>
      case server_supported_version extensions of
        Left problem => Left problem
        Right version =>
          if version_is_tls13 version
            then Right
              (MkTls13ServerHello
                (server_hello_kind random)
                random
                session_id
                suite_code
                suite
                extensions)
            else Left "ServerHello selected a protocol version other than TLS 1.3"
    Right (MkParsedExtensionVector _ _) => Left "bytes remain after ServerHello extensions"

parse_server_selection : List Bits8 → List Bits8 → Either String tls13_server_hello
parse_server_selection random session_id (suite_high :: suite_low :: compression :: rest) =
  if compression /= 0
    then Left "TLS 1.3 ServerHello legacy compression method must be zero"
    else let suite_code = MkCipherSuiteCode (wire_u16 suite_high suite_low) in
      case tls13_cipher_suite_from_code suite_code of
        Nothing => Left "ServerHello selected an unsupported TLS 1.3 cipher suite"
        Just suite => parse_server_extensions random session_id suite_code suite rest
parse_server_selection _ _ _ = Left "ServerHello selection fields are truncated"

parse_server_session : List Bits8 → List Bits8 → Either String tls13_server_hello
parse_server_session random [] = Left "ServerHello is missing legacy session id length"
parse_server_session random (session_length :: rest) =
  let session_length_number : ℕ = cast session_length in
    if session_length_number > 32
      then Left "ServerHello legacy session id echo exceeds 32 bytes"
      else case take_bytes_exact session_length_number rest of
        Nothing => Left "ServerHello legacy session id echo is truncated"
        Just (session_id, after_session) =>
          parse_server_selection random session_id after_session

public export
parse_tls13_server_hello : List Bits8 → Either String tls13_server_hello
parse_tls13_server_hello (3 :: 3 :: rest) =
  case take_bytes_exact 32 rest of
    Nothing => Left "ServerHello random is truncated"
    Just (random, after_random) => parse_server_session random after_random
parse_tls13_server_hello (_ :: _ :: _) =
  Left "TLS 1.3 ServerHello legacy_version must be 0x0303"
parse_tls13_server_hello _ = Left "ServerHello is missing legacy_version"
