module TLS.Alert

%default total

public export
choice tls_alert_level one_of
  warning
  fatal

public export
alert_level_from_wire : Bits8 → Either String tls_alert_level
alert_level_from_wire 1 = Right warning
alert_level_from_wire 2 = Right fatal
alert_level_from_wire value = Left ("unknown TLS alert level " ++ show value)

public export
choice tls_alert_description one_of
  close_notify
  unexpected_message
  bad_record_mac
  record_overflow
  handshake_failure
  bad_certificate
  unsupported_certificate
  certificate_revoked
  certificate_expired
  certificate_unknown
  illegal_parameter
  unknown_ca
  access_denied
  decode_error
  decrypt_error
  protocol_version
  insufficient_security
  internal_error
  inappropriate_fallback
  user_canceled
  missing_extension
  unsupported_extension
  unrecognized_name
  bad_certificate_status_response
  unknown_psk_identity
  certificate_required
  general_error
  no_application_protocol
  unknown_alert_description Bits8

public export
alert_description_from_wire : Bits8 → tls_alert_description
alert_description_from_wire 0 = close_notify
alert_description_from_wire 10 = unexpected_message
alert_description_from_wire 20 = bad_record_mac
alert_description_from_wire 22 = record_overflow
alert_description_from_wire 40 = handshake_failure
alert_description_from_wire 42 = bad_certificate
alert_description_from_wire 43 = unsupported_certificate
alert_description_from_wire 44 = certificate_revoked
alert_description_from_wire 45 = certificate_expired
alert_description_from_wire 46 = certificate_unknown
alert_description_from_wire 47 = illegal_parameter
alert_description_from_wire 48 = unknown_ca
alert_description_from_wire 49 = access_denied
alert_description_from_wire 50 = decode_error
alert_description_from_wire 51 = decrypt_error
alert_description_from_wire 70 = protocol_version
alert_description_from_wire 71 = insufficient_security
alert_description_from_wire 80 = internal_error
alert_description_from_wire 86 = inappropriate_fallback
alert_description_from_wire 90 = user_canceled
alert_description_from_wire 109 = missing_extension
alert_description_from_wire 110 = unsupported_extension
alert_description_from_wire 112 = unrecognized_name
alert_description_from_wire 113 = bad_certificate_status_response
alert_description_from_wire 115 = unknown_psk_identity
alert_description_from_wire 116 = certificate_required
alert_description_from_wire 117 = general_error
alert_description_from_wire 120 = no_application_protocol
alert_description_from_wire value = unknown_alert_description value

public export
record tls_alert where
  constructor MkTlsAlert
  alert_level : tls_alert_level
  alert_description : tls_alert_description

public export
parse_tls_alert : List Bits8 → Either String tls_alert
parse_tls_alert [level, description] =
  case alert_level_from_wire level of
    Left problem => Left problem
    Right parsed_level =>
      Right (MkTlsAlert parsed_level (alert_description_from_wire description))
parse_tls_alert _ = Left "TLS alert must contain exactly two bytes"

public export
choice tls_alert_effect one_of
  peer_closed_write
  user_canceled_notice
  fatal_connection_error

public export
alert_effect : tls_alert → Either String tls_alert_effect
alert_effect (MkTlsAlert warning close_notify) = Right peer_closed_write
alert_effect (MkTlsAlert fatal close_notify) =
  Left "close_notify must use warning level in TLS 1.3"
alert_effect (MkTlsAlert warning user_canceled) = Right user_canceled_notice
alert_effect (MkTlsAlert fatal user_canceled) = Right fatal_connection_error
alert_effect (MkTlsAlert _ _) = Right fatal_connection_error
