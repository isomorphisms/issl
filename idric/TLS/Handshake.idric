module TLS.Handshake

import TLS.Wire

%default total

public export
choice tls13_handshake_type one_of
  client_hello
  server_hello
  new_session_ticket
  end_of_early_data
  encrypted_extensions
  certificate
  certificate_request
  certificate_verify
  finished
  key_update
  message_hash

public export
handshake_type_from_wire : Byte → Either String tls13_handshake_type
handshake_type_from_wire 1 = Right client_hello
handshake_type_from_wire 2 = Right server_hello
handshake_type_from_wire 4 = Right new_session_ticket
handshake_type_from_wire 5 = Right end_of_early_data
handshake_type_from_wire 8 = Right encrypted_extensions
handshake_type_from_wire 11 = Right certificate
handshake_type_from_wire 13 = Right certificate_request
handshake_type_from_wire 15 = Right certificate_verify
handshake_type_from_wire 20 = Right finished
handshake_type_from_wire 24 = Right key_update
handshake_type_from_wire 254 = Right message_hash
handshake_type_from_wire value = Left ("unsupported TLS 1.3 handshake type " ++ show value)

public export
handshake_type_wire : tls13_handshake_type → Byte
handshake_type_wire client_hello = 1
handshake_type_wire server_hello = 2
handshake_type_wire new_session_ticket = 4
handshake_type_wire end_of_early_data = 5
handshake_type_wire encrypted_extensions = 8
handshake_type_wire certificate = 11
handshake_type_wire certificate_request = 13
handshake_type_wire certificate_verify = 15
handshake_type_wire finished = 20
handshake_type_wire key_update = 24
handshake_type_wire message_hash = 254

public export
record handshake_header where
  constructor MkHandshakeHeader
  handshake_kind : tls13_handshake_type
  handshake_length_number : ℕ

public export
record parsed_handshake_header where
  constructor MkParsedHandshakeHeader
  parsed_handshake : handshake_header
  remaining_handshake_bytes : bytes

public export
parse_handshake_header : bytes → Either String parsed_handshake_header
parse_handshake_header (kind :: length_high :: length_middle :: length_low :: rest) =
  case handshake_type_from_wire kind of
    Left problem => Left problem
    Right handshake_kind =>
      Right
        (MkParsedHandshakeHeader
          (MkHandshakeHeader
            handshake_kind
            (u24_number length_high length_middle length_low))
          rest)
parse_handshake_header _ = Left "TLS handshake header requires four bytes"

public export
record handshake_message where
  constructor MkHandshakeMessage
  message_kind : tls13_handshake_type
  message_body : bytes

public export
record parsed_handshake_message where
  constructor MkParsedHandshakeMessage
  parsed_message : handshake_message
  transcript_message_bytes : bytes
  bytes_after_handshake_message : bytes

public export
parse_handshake_message : bytes → Either String parsed_handshake_message
parse_handshake_message
  (kind :: length_high :: length_middle :: length_low :: rest) =
    case handshake_type_from_wire kind of
      Left problem => Left problem
      Right message_kind =>
        let body_length = u24_number length_high length_middle length_low in
          case take_exact body_length rest of
            Nothing => Left "TLS handshake body is truncated"
            Just (body, trailing) =>
              Right
                (MkParsedHandshakeMessage
                  (MkHandshakeMessage message_kind body)
                  (kind :: length_high :: length_middle :: length_low :: body)
                  trailing)
parse_handshake_message _ = Left "TLS handshake message requires a four-byte header"
