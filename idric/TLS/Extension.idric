module TLS.Extension

import TLS.Wire

%default total

public export
record protocol_version where
  constructor MkProtocolVersion
  protocol_version_major : Byte
  protocol_version_minor : Byte

public export
tls13_version : protocol_version
tls13_version = MkProtocolVersion 3 4

public export
record tls_extension where
  constructor MkTlsExtension
  extension_type_code : WireCode
  extension_data : bytes

public export
supported_versions_code : WireCode
supported_versions_code = 43

public export
signature_algorithms_code : WireCode
signature_algorithms_code = 13

public export
signature_algorithms_cert_code : WireCode
signature_algorithms_cert_code = 50

public export
supported_groups_code : WireCode
supported_groups_code = 10

public export
key_share_code : WireCode
key_share_code = 51

public export
pre_shared_key_code : WireCode
pre_shared_key_code = 41

public export
psk_key_exchange_modes_code : WireCode
psk_key_exchange_modes_code = 45

extension_code_present : WireCode → List tls_extension → Bool
extension_code_present wanted [] = False
extension_code_present wanted (extension :: rest) =
  extension.extension_type_code == wanted || extension_code_present wanted rest

parse_extension_entries_with_fuel :
  ℕ →
  bytes →
  Either String (List tls_extension)
parse_extension_entries_with_fuel _ [] = Right []
parse_extension_entries_with_fuel 0 _ =
  Left "TLS extension parser exhausted its input bound"
parse_extension_entries_with_fuel
  (S fuel)
  (type_high :: type_low :: length_high :: length_low :: rest) =
    let data_length = u16_number length_high length_low
        extension_code = u16_code type_high type_low in
      case take_exact data_length rest of
        Nothing => Left "TLS extension data is truncated"
        Just (data_bytes, trailing) =>
          case parse_extension_entries_with_fuel fuel trailing of
            Left problem => Left problem
            Right extensions =>
              if extension_code_present extension_code extensions
                then Left "TLS extension block contains a duplicate extension type"
                else Right
                  (MkTlsExtension extension_code data_bytes :: extensions)
parse_extension_entries_with_fuel (S _) _ =
  Left "TLS extension header is truncated"

parse_extension_entries : bytes → Either String (List tls_extension)
parse_extension_entries input =
  parse_extension_entries_with_fuel (length input) input

public export
record parsed_extension_vector where
  constructor MkParsedExtensionVector
  parsed_extensions : List tls_extension
  bytes_after_extensions : bytes

public export
parse_extension_vector : bytes → Either String parsed_extension_vector
parse_extension_vector (length_high :: length_low :: rest) =
  let vector_length = u16_number length_high length_low in
    case take_exact vector_length rest of
      Nothing => Left "TLS extension vector is truncated"
      Just (extension_bytes, trailing) =>
        case parse_extension_entries extension_bytes of
          Left problem => Left problem
          Right extensions => Right (MkParsedExtensionVector extensions trailing)
parse_extension_vector _ = Left "TLS extension vector requires a two-byte length"

public export
find_single_extension : WireCode → List tls_extension → Either String (Maybe tls_extension)
find_single_extension wanted [] = Right Nothing
find_single_extension wanted (extension :: rest) =
  if extension.extension_type_code == wanted
    then case find_single_extension wanted rest of
      Left problem => Left problem
      Right Nothing => Right (Just extension)
      Right (Just _) => Left "duplicate TLS extension"
    else find_single_extension wanted rest

parse_protocol_versions : bytes → Either String (List protocol_version)
parse_protocol_versions [] = Right []
parse_protocol_versions (major :: minor :: rest) =
  case parse_protocol_versions rest of
    Left problem => Left problem
    Right versions => Right (MkProtocolVersion major minor :: versions)
parse_protocol_versions _ = Left "supported_versions contains a partial protocol version"

public export
parse_client_supported_versions : tls_extension → Either String (List protocol_version)
parse_client_supported_versions extension =
  if extension.extension_type_code /= supported_versions_code
    then Left "expected supported_versions extension"
    else case extension.extension_data of
      [] => Left "client supported_versions is empty"
      declared_length :: version_bytes =>
        if cast declared_length /= length version_bytes
          then Left "client supported_versions length does not match its payload"
          else if length version_bytes < 2
            then Left "client supported_versions must contain at least one version"
            else parse_protocol_versions version_bytes

public export
version_is_tls13 : protocol_version → Bool
version_is_tls13 (MkProtocolVersion 3 4) = True
version_is_tls13 _ = False

public export
versions_include_tls13 : List protocol_version → Bool
versions_include_tls13 [] = False
versions_include_tls13 (version :: rest) =
  version_is_tls13 version || versions_include_tls13 rest

public export
parse_server_supported_version : tls_extension → Either String protocol_version
parse_server_supported_version extension =
  if extension.extension_type_code /= supported_versions_code
    then Left "expected supported_versions extension"
    else case extension.extension_data of
      [major, minor] => Right (MkProtocolVersion major minor)
      _ => Left "server supported_versions must contain one protocol version"
